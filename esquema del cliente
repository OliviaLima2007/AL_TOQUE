CREATE TABLE ciudadanos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    dni VARCHAR(20) NOT NULL,
    nombre VARCHAR(100) NOT NULL,
    telefono VARCHAR(30),
    direccion VARCHAR(200),
    multas DECIMAL(10, 2) DEFAULT 0.00,
    imp_inmobiliario DECIMAL(10, 2) DEFAULT 0.00,
    abl DECIMAL(10, 2) DEFAULT 0.00,
    domiciliario DECIMAL(10, 2) DEFAULT 0.00,
    exp_numero VARCHAR(50),
    exp_tramite VARCHAR(100),
    exp_estado VARCHAR(50),
    patente VARCHAR(15),
    INDEX idx_dni (dni),
    INDEX idx_patente (patente),
    INDEX idx_expediente (exp_numero)
);
